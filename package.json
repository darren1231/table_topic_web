{
  "name": "table-topic-web-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Regression test foundation for the Table Topics static web app",
  "scripts": {
    "serve:test": "http-server . -a 127.0.0.1 -p 4173 -c-1",
    "check:syntax": "node --check app.js && node --check cloud.js",
    "test:unit": "node --test tests/unit/*.test.cjs",
    "test:e2e": "playwright test",
    "test": "npm run check:syntax && npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.54.2",
    "http-server": "14.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
